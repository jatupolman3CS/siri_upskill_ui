{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm audit:*)",
      "Bash(npm view:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git init:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(npm uninstall:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push:*)",
      "Bash(dotnet ef database drop:*)",
      "Read(./**/appsettings.Production.json)",
      "Read(./**/*.pfx)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
